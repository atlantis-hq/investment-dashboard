# Backend (Mac mini)
# Local Postgres connection. The seed script and API server both read this.
DATABASE_URL=postgres://bentor:CHANGE_ME@localhost:5432/bentor
# Random hex (e.g. `openssl rand -hex 32`). Same value goes in Vercel env.
API_TOKEN=CHANGE_ME_64_HEX
# Port the Node API listens on (loopback). Tailscale Funnel proxies to this.
PORT=8443

# Vercel (set in dashboard, not here)
# MAC_MINI_API_URL=https://mac-mini-de-reiser.tail<...>.ts.net
# API_TOKEN=<same as above>
# DASHBOARD_USERS={"asier":"...","igor":"..."}
